generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  nurse
  clinician
  patient
  caregiver
  support
}

enum AuditAction {
  DEMO_LOGIN
  SESSION_LOGOUT
  ROLE_ASSIGNED
  ROLE_REVOKED
  CRITICAL_MUTATION
  LEGAL_RECORD_CREATED
  LEGAL_RECORD_REVOKED
  POLICY_VERSION_CREATED
  EPISODE_CREATED
  EPISODE_TRANSITIONED
  SAFETY_PLAN_VERSION_CREATED
  SAFETY_PLAN_VERSION_ACTIVATED
  SAFETY_PLAN_VERSION_INVALIDATED
}

enum IdentityVerificationState {
  PENDING
  VERIFIED
  REJECTED
}

enum DischargeEpisodeStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
}

enum SafetyPlanVersionState {
  DRAFT
  ACTIVE
  SUPERSEDED
  INVALIDATED
}

enum SafetyPlanStep {
  WARNING_SIGNS
  INTERNAL_COPING
  DISTRACTION_CONTACTS
  SUPPORT_CONTACTS
  PROFESSIONAL_RESOURCES
  MEANS_REDUCTION
}

enum SafetyPlanProvenance {
  PATIENT
  NURSE
  CLINICIAN
}

enum SafetyPlanAudience {
  PATIENT
  CAREGIVER
}

enum LegalRecordState {
  PENDING
  ACTIVE
  DECLINED
}

enum PolicyState {
  PENDING
  APPROVED
  WITHDRAWN
  SUPERSEDED
}

enum RecordOrigin {
  DEMO_UI
  PROFESSIONAL_ENTRY
  INSTITUTIONAL_CONFIGURATION
}

enum EvidenceType {
  RECORDED_INTERACTION
  INSTITUTIONAL_DECISION_REFERENCE
  SYSTEM_IMPORT_REFERENCE
}

enum CommunicationChannel {
  SMS
  EMAIL
  PUSH
}

enum LegalRecordType {
  PARTICIPATION
  DIGITAL_PARTICIPATION
  COMMUNICATION_PERMISSION
  CAREGIVER_AUTHORIZATION
  PROCESSING_BASIS
}

enum RevocationState {
  REVOKED
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}

model User {
  id                                  String                       @id @default(cuid())
  syntheticAlias                      String                       @unique @map("synthetic_alias") @db.VarChar(64)
  displayLabel                        String                       @map("display_label") @db.VarChar(160)
  isSynthetic                         Boolean                      @default(false) @map("is_synthetic")
  isActive                            Boolean                      @default(true) @map("is_active")
  createdAt                           DateTime                     @default(now()) @map("created_at")
  roleAssignments                     RoleAssignment[]             @relation("UserRoleAssignments")
  rolesAssigned                       RoleAssignment[]             @relation("RoleAssigner")
  sessions                            SessionMetadata[]
  auditEvents                         AuditEvent[]                 @relation("AuditActor")
  policyVersions                      PolicyVersion[]              @relation("PolicyVersionActor")
  participationRecords                ParticipationRecord[]        @relation("ParticipationSubject")
  participationRecordsAuthored        ParticipationRecord[]        @relation("ParticipationActor")
  digitalParticipationRecords         DigitalParticipationRecord[] @relation("DigitalParticipationSubject")
  digitalParticipationRecordsAuthored DigitalParticipationRecord[] @relation("DigitalParticipationActor")
  communicationPermissions            CommunicationPermission[]    @relation("CommunicationSubject")
  communicationPermissionsAuthored    CommunicationPermission[]    @relation("CommunicationActor")
  caregiverAuthorizations             CaregiverAuthorization[]     @relation("CaregiverAuthorizationSubject")
  caregiverAccessAuthorizations       CaregiverAuthorization[]     @relation("CaregiverAuthorizationCaregiver")
  caregiverAuthorizationsAuthored     CaregiverAuthorization[]     @relation("CaregiverAuthorizationActor")
  processingBasisRecords              ProcessingBasisRecord[]      @relation("ProcessingBasisSubject")
  processingBasisRecordsAuthored      ProcessingBasisRecord[]      @relation("ProcessingBasisActor")
  revocationEvents                    RevocationEvent[]            @relation("RevocationSubject")
  revocationEventsAuthored            RevocationEvent[]            @relation("RevocationActor")
  identityPoliciesAuthored            IdentityVerificationPolicyVersion[] @relation("IdentityPolicyActor")
  patientsCreated                     Patient[]                     @relation("PatientCreator")
  patientsIdentityVerified            Patient[]                     @relation("PatientIdentityVerifier")
  dischargeEpisodesCreated            DischargeEpisode[]            @relation("EpisodeCreator")
  dischargeEpisodesAsNurse            DischargeEpisode[]            @relation("EpisodeResponsibleNurse")
  dischargeEpisodesAsClinician        DischargeEpisode[]            @relation("EpisodeResponsibleClinician")
  dischargeEpisodesClosed             DischargeEpisode[]            @relation("EpisodeCloser")
  episodeTransitions                  EpisodeTransition[]           @relation("EpisodeTransitionActor")
  patientPortalProfile                Patient?                      @relation("PatientPortalUser")
  safetyPlansCreated                  SafetyPlan[]                   @relation("SafetyPlanCreator")
  safetyPlanVersionsCreated           SafetyPlanVersion[]            @relation("SafetyPlanVersionCreator")
  safetyPlanStateChanges              SafetyPlanVersionStateChange[] @relation("SafetyPlanStateActor")

  @@map("users")
}

model IdentityVerificationPolicyVersion {
  id            String                    @id @default(cuid())
  policyKey     String                    @map("policy_key") @db.VarChar(64)
  version       String                    @db.VarChar(32)
  state         PolicyState
  acceptedState IdentityVerificationState @map("accepted_state")
  processCode   String                    @map("process_code") @db.VarChar(64)
  processVersion  String                   @map("process_version") @db.VarChar(32)
  isSyntheticDemo Boolean                  @default(false) @map("is_synthetic_demo")
  actorUserId   String                    @map("actor_user_id")
  recordedAt    DateTime                  @default(now()) @map("recorded_at")
  actor         User                      @relation("IdentityPolicyActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  patients      Patient[]

  @@unique([policyKey, version])
  @@index([policyKey, recordedAt])
  @@map("identity_verification_policy_versions")
}

model Patient {
  id                                  String                    @id @default(cuid())
  externalPseudonymousId              String                    @unique @map("external_pseudonymous_id") @db.VarChar(64)
  isSynthetic                         Boolean                   @default(false) @map("is_synthetic")
  identityVerificationState           IdentityVerificationState @default(PENDING) @map("identity_verification_state")
  identityVerificationPolicyVersionId String?                   @map("identity_verification_policy_version_id")
  identityVerifiedAt                  DateTime?                 @map("identity_verified_at")
  identityVerifiedById                String?                   @map("identity_verified_by_id")
  createdById                         String                    @map("created_by_id")
  portalUserId                        String?                   @unique @map("portal_user_id")
  createdAt                           DateTime                  @default(now()) @map("created_at")
  updatedAt                           DateTime                  @updatedAt @map("updated_at")
  identityVerificationPolicyVersion   IdentityVerificationPolicyVersion? @relation(fields: [identityVerificationPolicyVersionId], references: [id], onDelete: Restrict)
  identityVerifiedBy                  User?                     @relation("PatientIdentityVerifier", fields: [identityVerifiedById], references: [id], onDelete: Restrict)
  createdBy                           User                      @relation("PatientCreator", fields: [createdById], references: [id], onDelete: Restrict)
  portalUser                          User?                     @relation("PatientPortalUser", fields: [portalUserId], references: [id], onDelete: Restrict)
  dischargeEpisodes                  DischargeEpisode[]

  @@index([identityVerificationState])
  @@map("patients")
}

model DischargeEpisode {
  id                       String                 @id @default(cuid())
  patientId                String                 @map("patient_id")
  dischargeDate            DateTime               @map("discharge_date") @db.Date
  programLengthDays        Int                    @map("program_length_days")
  responsibleNurseId       String                 @map("responsible_nurse_id")
  responsibleClinicianId   String                 @map("responsible_clinician_id")
  status                   DischargeEpisodeStatus @default(DRAFT)
  createdById              String                 @map("created_by_id")
  closedReason             String?                @map("closed_reason") @db.VarChar(500)
  closedById               String?                @map("closed_by_id")
  closedAt                 DateTime?              @map("closed_at")
  createdAt                DateTime               @default(now()) @map("created_at")
  updatedAt                DateTime               @updatedAt @map("updated_at")
  version                  Int                    @default(1)
  patient                  Patient                @relation(fields: [patientId], references: [id], onDelete: Restrict)
  responsibleNurse         User                   @relation("EpisodeResponsibleNurse", fields: [responsibleNurseId], references: [id], onDelete: Restrict)
  responsibleClinician     User                   @relation("EpisodeResponsibleClinician", fields: [responsibleClinicianId], references: [id], onDelete: Restrict)
  createdBy                User                   @relation("EpisodeCreator", fields: [createdById], references: [id], onDelete: Restrict)
  closedBy                 User?                  @relation("EpisodeCloser", fields: [closedById], references: [id], onDelete: Restrict)
  transitions              EpisodeTransition[]
  safetyPlan               SafetyPlan?

  @@index([responsibleNurseId, status])
  @@index([responsibleClinicianId, status])
  @@index([patientId, createdAt])
  @@map("discharge_episodes")
}

model SafetyPlan {
  id                  String              @id @default(cuid())
  dischargeEpisodeId  String              @unique @map("discharge_episode_id")
  revision            Int                 @default(0)
  currentVersion      Int                 @default(0) @map("current_version")
  activeVersionNumber Int?                @map("active_version_number")
  createdById         String              @map("created_by_id")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  dischargeEpisode    DischargeEpisode    @relation(fields: [dischargeEpisodeId], references: [id], onDelete: Restrict)
  createdBy           User                @relation("SafetyPlanCreator", fields: [createdById], references: [id], onDelete: Restrict)
  versions            SafetyPlanVersion[]

  @@map("safety_plans")
}

model SafetyPlanVersion {
  id                 String                         @id @default(cuid())
  safetyPlanId       String                         @map("safety_plan_id")
  versionNumber      Int                            @map("version_number")
  basedOnVersion     Int?                           @map("based_on_version")
  createdById        String                         @map("created_by_id")
  createdAt          DateTime                       @default(now()) @map("created_at")
  safetyPlan         SafetyPlan                     @relation(fields: [safetyPlanId], references: [id], onDelete: Restrict)
  createdBy          User                           @relation("SafetyPlanVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  sections           SafetyPlanSection[]
  stateChanges       SafetyPlanVersionStateChange[]

  @@unique([safetyPlanId, versionNumber])
  @@index([safetyPlanId, createdAt])
  @@map("safety_plan_versions")
}

model SafetyPlanSection {
  id                  String                        @id @default(cuid())
  safetyPlanVersionId String                        @map("safety_plan_version_id")
  step                SafetyPlanStep
  content             String                        @db.Text
  provenance          SafetyPlanProvenance
  safetyPlanVersion   SafetyPlanVersion             @relation(fields: [safetyPlanVersionId], references: [id], onDelete: Restrict)
  permissions         SafetyPlanSectionPermission[]

  @@unique([safetyPlanVersionId, step])
  @@map("safety_plan_sections")
}

model SafetyPlanSectionPermission {
  id                  String             @id @default(cuid())
  safetyPlanSectionId String             @map("safety_plan_section_id")
  audience            SafetyPlanAudience
  canView             Boolean            @map("can_view")
  safetyPlanSection   SafetyPlanSection  @relation(fields: [safetyPlanSectionId], references: [id], onDelete: Restrict)

  @@unique([safetyPlanSectionId, audience])
  @@map("safety_plan_section_permissions")
}

model SafetyPlanVersionStateChange {
  id                  String                 @id @default(cuid())
  safetyPlanVersionId String                 @map("safety_plan_version_id")
  sequence            Int
  resultingState      SafetyPlanVersionState @map("resulting_state")
  reason              String?                @db.VarChar(500)
  actorUserId         String                 @map("actor_user_id")
  occurredAt          DateTime               @default(now()) @map("occurred_at")
  safetyPlanVersion   SafetyPlanVersion      @relation(fields: [safetyPlanVersionId], references: [id], onDelete: Restrict)
  actor               User                   @relation("SafetyPlanStateActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([safetyPlanVersionId, sequence])
  @@index([safetyPlanVersionId, occurredAt])
  @@map("safety_plan_version_state_changes")
}

model EpisodeTransition {
  id                 String                  @id @default(cuid())
  episodeId          String                  @map("episode_id")
  fromStatus         DischargeEpisodeStatus? @map("from_status")
  toStatus           DischargeEpisodeStatus  @map("to_status")
  actorUserId        String                  @map("actor_user_id")
  actorRole          Role                    @map("actor_role")
  reason             String?                 @db.VarChar(500)
  idempotencyKey     String                  @map("idempotency_key") @db.VarChar(128)
  requestFingerprint String                  @map("request_fingerprint") @db.Char(64)
  resultingVersion   Int                     @map("resulting_version")
  occurredAt         DateTime                @default(now()) @map("occurred_at")
  episode            DischargeEpisode        @relation(fields: [episodeId], references: [id], onDelete: Restrict)
  actor              User                    @relation("EpisodeTransitionActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([actorUserId, idempotencyKey])
  @@unique([episodeId, resultingVersion])
  @@index([episodeId, occurredAt])
  @@map("episode_transitions")
}

model PolicyVersion {
  id                          String                       @id @default(cuid())
  policyKey                   String                       @map("policy_key") @db.VarChar(64)
  version                     String                       @db.VarChar(32)
  recordType                  LegalRecordType              @map("record_type")
  state                       PolicyState
  scope                       String                       @db.VarChar(128)
  actorUserId                 String                       @map("actor_user_id")
  recordedAt                  DateTime                     @default(now()) @map("recorded_at")
  origin                      RecordOrigin
  evidenceType                EvidenceType                 @map("evidence_type")
  evidenceRef                 String                       @map("evidence_ref") @db.VarChar(128)
  actor                       User                         @relation("PolicyVersionActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  participationRecords        ParticipationRecord[]
  digitalParticipationRecords DigitalParticipationRecord[]
  communicationPermissions    CommunicationPermission[]
  caregiverAuthorizations     CaregiverAuthorization[]
  processingBasisRecords      ProcessingBasisRecord[]
  revocationEvents            RevocationEvent[]

  @@unique([policyKey, version])
  @@index([policyKey, recordedAt])
  @@map("policy_versions")
}

model ParticipationRecord {
  id              String           @id @default(cuid())
  subjectUserId   String           @map("subject_user_id")
  state           LegalRecordState
  scope           String           @db.VarChar(128)
  policyVersionId String           @map("policy_version_id")
  actorUserId     String           @map("actor_user_id")
  recordedAt      DateTime         @default(now()) @map("recorded_at")
  expiresAt       DateTime?        @map("expires_at")
  origin          RecordOrigin
  evidenceType    EvidenceType     @map("evidence_type")
  evidenceRef     String           @map("evidence_ref") @db.VarChar(128)
  subject         User             @relation("ParticipationSubject", fields: [subjectUserId], references: [id], onDelete: Restrict)
  actor           User             @relation("ParticipationActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  policyVersion   PolicyVersion    @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)

  @@index([subjectUserId, scope, recordedAt])
  @@map("participation_records")
}

model DigitalParticipationRecord {
  id              String           @id @default(cuid())
  subjectUserId   String           @map("subject_user_id")
  state           LegalRecordState
  scope           String           @db.VarChar(128)
  policyVersionId String           @map("policy_version_id")
  actorUserId     String           @map("actor_user_id")
  recordedAt      DateTime         @default(now()) @map("recorded_at")
  expiresAt       DateTime?        @map("expires_at")
  origin          RecordOrigin
  evidenceType    EvidenceType     @map("evidence_type")
  evidenceRef     String           @map("evidence_ref") @db.VarChar(128)
  subject         User             @relation("DigitalParticipationSubject", fields: [subjectUserId], references: [id], onDelete: Restrict)
  actor           User             @relation("DigitalParticipationActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  policyVersion   PolicyVersion    @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)

  @@index([subjectUserId, scope, recordedAt])
  @@map("digital_participation_records")
}

model CommunicationPermission {
  id              String               @id @default(cuid())
  subjectUserId   String               @map("subject_user_id")
  state           LegalRecordState
  scope           String               @db.VarChar(128)
  channel         CommunicationChannel
  purpose         String               @db.VarChar(64)
  policyVersionId String               @map("policy_version_id")
  actorUserId     String               @map("actor_user_id")
  recordedAt      DateTime             @default(now()) @map("recorded_at")
  expiresAt       DateTime?            @map("expires_at")
  origin          RecordOrigin
  evidenceType    EvidenceType         @map("evidence_type")
  evidenceRef     String               @map("evidence_ref") @db.VarChar(128)
  subject         User                 @relation("CommunicationSubject", fields: [subjectUserId], references: [id], onDelete: Restrict)
  actor           User                 @relation("CommunicationActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  policyVersion   PolicyVersion        @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)

  @@index([subjectUserId, channel, purpose, recordedAt])
  @@map("communication_permissions")
}

model CaregiverAuthorization {
  id              String           @id @default(cuid())
  subjectUserId   String           @map("subject_user_id")
  caregiverUserId String           @map("caregiver_user_id")
  state           LegalRecordState
  scope           String           @db.VarChar(128)
  policyVersionId String           @map("policy_version_id")
  actorUserId     String           @map("actor_user_id")
  recordedAt      DateTime         @default(now()) @map("recorded_at")
  expiresAt       DateTime?        @map("expires_at")
  origin          RecordOrigin
  evidenceType    EvidenceType     @map("evidence_type")
  evidenceRef     String           @map("evidence_ref") @db.VarChar(128)
  subject         User             @relation("CaregiverAuthorizationSubject", fields: [subjectUserId], references: [id], onDelete: Restrict)
  caregiver       User             @relation("CaregiverAuthorizationCaregiver", fields: [caregiverUserId], references: [id], onDelete: Restrict)
  actor           User             @relation("CaregiverAuthorizationActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  policyVersion   PolicyVersion    @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)

  @@index([subjectUserId, caregiverUserId, scope, recordedAt])
  @@map("caregiver_authorizations")
}

model ProcessingBasisRecord {
  id              String           @id @default(cuid())
  subjectUserId   String           @map("subject_user_id")
  state           LegalRecordState
  scope           String           @db.VarChar(128)
  basisCode       String           @map("basis_code") @db.VarChar(64)
  policyVersionId String           @map("policy_version_id")
  actorUserId     String           @map("actor_user_id")
  recordedAt      DateTime         @default(now()) @map("recorded_at")
  expiresAt       DateTime?        @map("expires_at")
  origin          RecordOrigin
  evidenceType    EvidenceType     @map("evidence_type")
  evidenceRef     String           @map("evidence_ref") @db.VarChar(128)
  subject         User             @relation("ProcessingBasisSubject", fields: [subjectUserId], references: [id], onDelete: Restrict)
  actor           User             @relation("ProcessingBasisActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  policyVersion   PolicyVersion    @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)

  @@index([subjectUserId, scope, recordedAt])
  @@map("processing_basis_records")
}

model RevocationEvent {
  id              String          @id @default(cuid())
  state           RevocationState @default(REVOKED)
  targetType      LegalRecordType @map("target_type")
  targetRecordId  String          @map("target_record_id") @db.VarChar(128)
  subjectUserId   String          @map("subject_user_id")
  scope           String          @db.VarChar(128)
  policyVersionId String          @map("policy_version_id")
  actorUserId     String          @map("actor_user_id")
  recordedAt      DateTime        @default(now()) @map("recorded_at")
  origin          RecordOrigin
  evidenceType    EvidenceType    @map("evidence_type")
  evidenceRef     String          @map("evidence_ref") @db.VarChar(128)
  subject         User            @relation("RevocationSubject", fields: [subjectUserId], references: [id], onDelete: Restrict)
  actor           User            @relation("RevocationActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  policyVersion   PolicyVersion   @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)

  @@unique([targetType, targetRecordId])
  @@index([subjectUserId, recordedAt])
  @@map("revocation_events")
}

model RoleAssignment {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  role         Role
  assignedById String?   @map("assigned_by_id")
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  revokedAt    DateTime? @map("revoked_at")
  user         User      @relation("UserRoleAssignments", fields: [userId], references: [id], onDelete: Restrict)
  assignedBy   User?     @relation("RoleAssigner", fields: [assignedById], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@index([assignedById])
  @@map("role_assignments")
}

model SessionMetadata {
  id                   String    @id @default(cuid())
  userId               String    @map("user_id")
  sessionTokenHash     String    @unique @map("session_token_hash") @db.Char(64)
  authenticationMethod String    @map("authentication_method") @db.VarChar(32)
  correlationId        String    @map("correlation_id") @db.Uuid
  userAgentHash        String?   @map("user_agent_hash") @db.Char(64)
  createdAt            DateTime  @default(now()) @map("created_at")
  expiresAt            DateTime  @map("expires_at")
  revokedAt            DateTime? @map("revoked_at")
  user                 User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt, expiresAt])
  @@map("session_metadata")
}

model AuditEvent {
  id            String       @id @default(cuid())
  actorUserId   String?      @map("actor_user_id")
  actorRole     Role?        @map("actor_role")
  action        AuditAction
  resourceType  String       @map("resource_type") @db.VarChar(64)
  resourceId    String?      @map("resource_id") @db.VarChar(128)
  outcome       AuditOutcome
  correlationId String       @map("correlation_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at")
  actor         User?        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, createdAt])
  @@index([correlationId])
  @@map("audit_events")
}
