model Task {
  id                     String           @id @default(cuid())
  episodeId              String           @map("episode_id")
  alertId                String?          @map("alert_id")
  summary                String           @db.VarChar(160)
  currentState           TaskState        @default(OPEN) @map("current_state")
  assignedToId           String?          @map("assigned_to_id")
  createdById            String           @map("created_by_id")
  creationIdempotencyKey String           @map("creation_idempotency_key") @db.VarChar(112)
  creationFingerprint    String           @map("creation_fingerprint") @db.Char(64)
  revision               Int              @default(1)
  resolvedById           String?          @map("resolved_by_id")
  resolvedAt             DateTime?        @map("resolved_at")
  resolutionReason       String?          @map("resolution_reason") @db.VarChar(500)
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")
  episode                DischargeEpisode @relation(fields: [episodeId], references: [id], onDelete: Restrict, map: "tasks_episode_fkey")
  alert                  Alert?           @relation(fields: [alertId, episodeId], references: [id, episodeId], onDelete: Restrict, map: "tasks_alert_episode_fkey")
  assignedTo             User?            @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: Restrict, map: "tasks_assignee_fkey")
  createdBy              User             @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict, map: "tasks_creator_fkey")
  resolvedBy             User?            @relation("TaskResolver", fields: [resolvedById], references: [id], onDelete: Restrict, map: "tasks_resolver_fkey")
  events                 TaskEvent[]

  @@unique([createdById, creationIdempotencyKey], map: "tasks_creator_idempotency_key")
  @@unique([id, revision], map: "tasks_id_revision_key")
  @@index([episodeId, currentState, createdAt], map: "tasks_episode_state_created_idx")
  @@index([assignedToId, currentState, createdAt], map: "tasks_assignee_state_created_idx")
  @@map("tasks")
}

