generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  nurse
  clinician
  patient
  caregiver
  support
}

enum AuditAction {
  DEMO_LOGIN
  SESSION_LOGOUT
  ROLE_ASSIGNED
  ROLE_REVOKED
  CRITICAL_MUTATION
  LEGAL_RECORD_CREATED
  LEGAL_RECORD_REVOKED
  POLICY_VERSION_CREATED
}

enum LegalRecordState {
  PENDING
  ACTIVE
  DECLINED
}

enum PolicyState {
  PENDING
  APPROVED
  WITHDRAWN
  SUPERSEDED
}

enum RecordOrigin {
  DEMO_UI
  PROFESSIONAL_ENTRY
  INSTITUTIONAL_CONFIGURATION
}

enum EvidenceType {
  RECORDED_INTERACTION
  INSTITUTIONAL_DECISION_REFERENCE
  SYSTEM_IMPORT_REFERENCE
}

enum CommunicationChannel {
  SMS
  EMAIL
  PUSH
}

enum LegalRecordType {
  PARTICIPATION
  DIGITAL_PARTICIPATION
  COMMUNICATION_PERMISSION
  CAREGIVER_AUTHORIZATION
  PROCESSING_BASIS
}

enum RevocationState {
  REVOKED
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}

model User {
  id                                  String                       @id @default(cuid())
  syntheticAlias                      String                       @unique @map("synthetic_alias") @db.VarChar(64)
  displayLabel                        String                       @map("display_label") @db.VarChar(160)
  isSynthetic                         Boolean                      @default(false) @map("is_synthetic")
  isActive                            Boolean                      @default(true) @map("is_active")
  createdAt                           DateTime                     @default(now()) @map("created_at")
  roleAssignments                     RoleAssignment[]             @relation("UserRoleAssignments")
  rolesAssigned                       RoleAssignment[]             @relation("RoleAssigner")
  sessions                            SessionMetadata[]
  auditEvents                         AuditEvent[]                 @relation("AuditActor")
  policyVersions                      PolicyVersion[]              @relation("PolicyVersionActor")
  participationRecords                ParticipationRecord[]        @relation("ParticipationSubject")
  participationRecordsAuthored        ParticipationRecord[]        @relation("ParticipationActor")
  digitalParticipationRecords         DigitalParticipationRecord[] @relation("DigitalParticipationSubject")
  digitalParticipationRecordsAuthored DigitalParticipationRecord[] @relation("DigitalParticipationActor")
  communicationPermissions            CommunicationPermission[]    @relation("CommunicationSubject")
  communicationPermissionsAuthored    CommunicationPermission[]    @relation("CommunicationActor")
  caregiverAuthorizations             CaregiverAuthorization[]     @relation("CaregiverAuthorizationSubject")
  caregiverAccessAuthorizations       CaregiverAuthorization[]     @relation("CaregiverAuthorizationCaregiver")
  caregiverAuthorizationsAuthored     CaregiverAuthorization[]     @relation("CaregiverAuthorizationActor")
  processingBasisRecords              ProcessingBasisRecord[]      @relation("ProcessingBasisSubject")
  processingBasisRecordsAuthored      ProcessingBasisRecord[]      @relation("ProcessingBasisActor")
  revocationEvents                    RevocationEvent[]            @relation("RevocationSubject")
  revocationEventsAuthored            RevocationEvent[]            @relation("RevocationActor")

  @@map("users")
}

model PolicyVersion {
  id                          String                       @id @default(cuid())
  policyKey                   String                       @map("policy_key") @db.VarChar(64)
  version                     String                       @db.VarChar(32)
  recordType                  LegalRecordType              @map("record_type")
  state                       PolicyState
  scope                       String                       @db.VarChar(128)
  actorUserId                 String                       @map("actor_user_id")
  recordedAt                  DateTime                     @default(now()) @map("recorded_at")
  origin                      RecordOrigin
  evidenceType                EvidenceType                 @map("evidence_type")
  evidenceRef                 String                       @map("evidence_ref") @db.VarChar(128)
  actor                       User                         @relation("PolicyVersionActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  participationRecords        ParticipationRecord[]
  digitalParticipationRecords DigitalParticipationRecord[]
  communicationPermissions    CommunicationPermission[]
  caregiverAuthorizations     CaregiverAuthorization[]
  processingBasisRecords      ProcessingBasisRecord[]
  revocationEvents            RevocationEvent[]

  @@unique([policyKey, version])
  @@index([policyKey, recordedAt])
  @@map("policy_versions")
}

model ParticipationRecord {
  id              String           @id @default(cuid())
  subjectUserId   String           @map("subject_user_id")
  state           LegalRecordState
  scope           String           @db.VarChar(128)
  policyVersionId String           @map("policy_version_id")
  actorUserId     String           @map("actor_user_id")
  recordedAt      DateTime         @default(now()) @map("recorded_at")
  expiresAt       DateTime?        @map("expires_at")
  origin          RecordOrigin
  evidenceType    EvidenceType     @map("evidence_type")
  evidenceRef     String           @map("evidence_ref") @db.VarChar(128)
  subject         User             @relation("ParticipationSubject", fields: [subjectUserId], references: [id], onDelete: Restrict)
  actor           User             @relation("ParticipationActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  policyVersion   PolicyVersion    @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)

  @@index([subjectUserId, scope, recordedAt])
  @@map("participation_records")
}

model DigitalParticipationRecord {
  id              String           @id @default(cuid())
  subjectUserId   String           @map("subject_user_id")
  state           LegalRecordState
  scope           String           @db.VarChar(128)
  policyVersionId String           @map("policy_version_id")
  actorUserId     String           @map("actor_user_id")
  recordedAt      DateTime         @default(now()) @map("recorded_at")
  expiresAt       DateTime?        @map("expires_at")
  origin          RecordOrigin
  evidenceType    EvidenceType     @map("evidence_type")
  evidenceRef     String           @map("evidence_ref") @db.VarChar(128)
  subject         User             @relation("DigitalParticipationSubject", fields: [subjectUserId], references: [id], onDelete: Restrict)
  actor           User             @relation("DigitalParticipationActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  policyVersion   PolicyVersion    @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)

  @@index([subjectUserId, scope, recordedAt])
  @@map("digital_participation_records")
}

model CommunicationPermission {
  id              String               @id @default(cuid())
  subjectUserId   String               @map("subject_user_id")
  state           LegalRecordState
  scope           String               @db.VarChar(128)
  channel         CommunicationChannel
  purpose         String               @db.VarChar(64)
  policyVersionId String               @map("policy_version_id")
  actorUserId     String               @map("actor_user_id")
  recordedAt      DateTime             @default(now()) @map("recorded_at")
  expiresAt       DateTime?            @map("expires_at")
  origin          RecordOrigin
  evidenceType    EvidenceType         @map("evidence_type")
  evidenceRef     String               @map("evidence_ref") @db.VarChar(128)
  subject         User                 @relation("CommunicationSubject", fields: [subjectUserId], references: [id], onDelete: Restrict)
  actor           User                 @relation("CommunicationActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  policyVersion   PolicyVersion        @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)

  @@index([subjectUserId, channel, purpose, recordedAt])
  @@map("communication_permissions")
}

model CaregiverAuthorization {
  id              String           @id @default(cuid())
  subjectUserId   String           @map("subject_user_id")
  caregiverUserId String           @map("caregiver_user_id")
  state           LegalRecordState
  scope           String           @db.VarChar(128)
  policyVersionId String           @map("policy_version_id")
  actorUserId     String           @map("actor_user_id")
  recordedAt      DateTime         @default(now()) @map("recorded_at")
  expiresAt       DateTime?        @map("expires_at")
  origin          RecordOrigin
  evidenceType    EvidenceType     @map("evidence_type")
  evidenceRef     String           @map("evidence_ref") @db.VarChar(128)
  subject         User             @relation("CaregiverAuthorizationSubject", fields: [subjectUserId], references: [id], onDelete: Restrict)
  caregiver       User             @relation("CaregiverAuthorizationCaregiver", fields: [caregiverUserId], references: [id], onDelete: Restrict)
  actor           User             @relation("CaregiverAuthorizationActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  policyVersion   PolicyVersion    @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)

  @@index([subjectUserId, caregiverUserId, scope, recordedAt])
  @@map("caregiver_authorizations")
}

model ProcessingBasisRecord {
  id              String           @id @default(cuid())
  subjectUserId   String           @map("subject_user_id")
  state           LegalRecordState
  scope           String           @db.VarChar(128)
  basisCode       String           @map("basis_code") @db.VarChar(64)
  policyVersionId String           @map("policy_version_id")
  actorUserId     String           @map("actor_user_id")
  recordedAt      DateTime         @default(now()) @map("recorded_at")
  expiresAt       DateTime?        @map("expires_at")
  origin          RecordOrigin
  evidenceType    EvidenceType     @map("evidence_type")
  evidenceRef     String           @map("evidence_ref") @db.VarChar(128)
  subject         User             @relation("ProcessingBasisSubject", fields: [subjectUserId], references: [id], onDelete: Restrict)
  actor           User             @relation("ProcessingBasisActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  policyVersion   PolicyVersion    @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)

  @@index([subjectUserId, scope, recordedAt])
  @@map("processing_basis_records")
}

model RevocationEvent {
  id              String          @id @default(cuid())
  state           RevocationState @default(REVOKED)
  targetType      LegalRecordType @map("target_type")
  targetRecordId  String          @map("target_record_id") @db.VarChar(128)
  subjectUserId   String          @map("subject_user_id")
  scope           String          @db.VarChar(128)
  policyVersionId String          @map("policy_version_id")
  actorUserId     String          @map("actor_user_id")
  recordedAt      DateTime        @default(now()) @map("recorded_at")
  origin          RecordOrigin
  evidenceType    EvidenceType    @map("evidence_type")
  evidenceRef     String          @map("evidence_ref") @db.VarChar(128)
  subject         User            @relation("RevocationSubject", fields: [subjectUserId], references: [id], onDelete: Restrict)
  actor           User            @relation("RevocationActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  policyVersion   PolicyVersion   @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)

  @@unique([targetType, targetRecordId])
  @@index([subjectUserId, recordedAt])
  @@map("revocation_events")
}

model RoleAssignment {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  role         Role
  assignedById String?   @map("assigned_by_id")
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  revokedAt    DateTime? @map("revoked_at")
  user         User      @relation("UserRoleAssignments", fields: [userId], references: [id], onDelete: Restrict)
  assignedBy   User?     @relation("RoleAssigner", fields: [assignedById], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@index([assignedById])
  @@map("role_assignments")
}

model SessionMetadata {
  id                   String    @id @default(cuid())
  userId               String    @map("user_id")
  sessionTokenHash     String    @unique @map("session_token_hash") @db.Char(64)
  authenticationMethod String    @map("authentication_method") @db.VarChar(32)
  correlationId        String    @map("correlation_id") @db.Uuid
  userAgentHash        String?   @map("user_agent_hash") @db.Char(64)
  createdAt            DateTime  @default(now()) @map("created_at")
  expiresAt            DateTime  @map("expires_at")
  revokedAt            DateTime? @map("revoked_at")
  user                 User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt, expiresAt])
  @@map("session_metadata")
}

model AuditEvent {
  id            String       @id @default(cuid())
  actorUserId   String?      @map("actor_user_id")
  actorRole     Role?        @map("actor_role")
  action        AuditAction
  resourceType  String       @map("resource_type") @db.VarChar(64)
  resourceId    String?      @map("resource_id") @db.VarChar(128)
  outcome       AuditOutcome
  correlationId String       @map("correlation_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at")
  actor         User?        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, createdAt])
  @@index([correlationId])
  @@map("audit_events")
}
