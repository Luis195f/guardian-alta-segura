model Alert {
  id                     String                 @id @default(cuid())
  ruleDefinitionId       String                 @map("rule_definition_id")
  ruleVersionId          String                 @map("rule_version_id")
  ruleVersionNumber      Int                    @map("rule_version_number")
  evaluationId           String                 @unique(map: "alerts_evaluation_key") @map("evaluation_id")
  episodeId              String                 @map("episode_id")
