  episode                DischargeEpisode       @relation(fields: [episodeId], references: [id], onDelete: Restrict, map: "alerts_episode_fkey")
  reviews                AlertReview[]
  tasks                  Task[]

  @@unique([evaluationId, ruleVersionId, episodeId], map: "alerts_evaluation_version_episode_key")
  @@unique([id, episodeId], map: "alerts_id_episode_key")
  @@index([episodeId, currentState, triggeredAt], map: "alerts_episode_state_time_idx")
  @@index([reviewOwner, currentState, triggeredAt], map: "alerts_owner_state_time_idx")
  @@map("alerts")
}

