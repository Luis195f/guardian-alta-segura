# SINTÉTICO / NO USO CLÍNICO. Copiar a .env solo para desarrollo local.
# Sustituye los placeholders localmente; no versionar credenciales reales.
DATABASE_URL="postgresql://guardian_demo:replace-with-local-demo-password@127.0.0.1:5432/guardian_demo?schema=public"
POSTGRES_PASSWORD="replace-with-local-demo-password"
APP_BASE_URL="http://127.0.0.1:3000"
DEMO_MODE="true"
DEMO_SESSION_TTL_HOURS="8"
SESSION_COOKIE_SECURE="false"
EXPLAINABLE_TRAFFIC_LIGHT="false"
